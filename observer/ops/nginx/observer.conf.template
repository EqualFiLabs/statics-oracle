limit_req_zone $binary_remote_addr zone=oracle_observer:10m rate=10r/s;
server {
    listen 8443 ssl;
    server_name _;
    ssl_certificate /etc/equalfi/statics-oracle/tls/server.crt;
    ssl_certificate_key /etc/equalfi/statics-oracle/tls/server.key;
    ssl_client_certificate /etc/equalfi/statics-oracle/tls/ca.crt;
    ssl_verify_client on;
    ssl_verify_depth 2;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    allow @COORDINATOR_IPV4@;
    deny all;
    client_max_body_size 16k;
    client_body_timeout 10s;
    limit_req zone=oracle_observer burst=20 nodelay;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_connect_timeout 2s;
        proxy_read_timeout 45s;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header X-Forwarded-Proto https;
    }
}
