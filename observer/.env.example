# Shared network configuration. Use 1 and 4663 for mainnet, or 11155111 and 46630 for testnet.
ETHEREUM_CHAIN_ID=1
ROBINHOOD_CHAIN_ID=4663
ETHEREUM_RPC_URL=https://replace-with-ethereum-rpc
ROBINHOOD_RPC_URL=https://replace-with-independent-robinhood-rpc
DIRECT_SEQUENCER_FEED_URL=wss://feed.mainnet.chain.robinhood.com
SEQUENCER_L1_REPORTER=0x0000000000000000000000000000000000000000
SEQUENCER_SIGNAL_FEED=0x0000000000000000000000000000000000000000

# Observer process. Run each observer with a distinct key and independent infrastructure.
OBSERVER_PRIVATE_KEY=0x
OBSERVER_AUTH_TOKEN=replace-with-at-least-32-random-bytes
OBSERVER_HOST=127.0.0.1
OBSERVER_PORT=8787
POLL_INTERVAL_MS=30000

# Coordinator process. Only one coordinator should use the primary role.
L1_RELAYER_PRIVATE_KEY=0x
L2_RELAYER_PRIVATE_KEY=0x
OBSERVER_URLS=http://observer-1:8787,http://observer-2:8787,http://observer-3:8787
# One distinct token per observer URL, in matching order.
OBSERVER_AUTH_TOKENS=replace-with-32-byte-observer-1-token,replace-with-32-byte-observer-2-token,replace-with-32-byte-observer-3-token
RELAYER_ROLE=primary
BACKUP_DELAY_MS=45000
RUN_ONCE=false
