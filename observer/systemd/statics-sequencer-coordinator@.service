[Unit]
Description=Statics Robinhood sequencer coordinator %i
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=statics-oracle
Group=statics-oracle
WorkingDirectory=/opt/equalfi/statics-oracle/observer
EnvironmentFile=/etc/equalfi/statics-oracle/coordinator-%i.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node src/coordinator.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
